# Supabase Project Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Supabase Management Access Token (NUNCA SUBIR EL TOKEN REAL A GIT)
# SUPABASE_ACCESS_TOKEN=your-access-token-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Service Role (server-side only, NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email SMTP Hostinger (correos transaccionales — confirmación, bienvenida)
SMTP_USER=info@kaltiro.com
SMTP_PASS=your-hostinger-email-password

# WhatsApp de soporte Kaltiro (para el botón "Activar mi plan" cuando el trial expira)
# Solo los 9 dígitos sin el 593, ej: 987654321
NEXT_PUBLIC_SOPORTE_WA=987654321
